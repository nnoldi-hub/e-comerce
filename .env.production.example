# Sablon pentru productie. Se copiaza ca `.env` pe server, se completeaza
# valorile marcate si NU se comite cu valori reale. Dupa orice modificare:
#   php artisan optimize && php artisan queue:restart
# Verificare: php artisan ops:check --production

APP_NAME="NK-Shop"
APP_ENV=production
# Se genereaza o singura data pe server: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://magazin.example.ro

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_comerce
DB_USERNAME=e_comerce
# Parola unui utilizator dedicat, cu drepturi doar pe aceasta baza (nu root)
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="comenzi@magazin.example.ro"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Plati
PAYMENT_CARD_GATEWAY=stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# Operare si securitate
ADMIN_LOCALE=ro
# Doar daca in fata aplicatiei sta un load balancer / Cloudflare (vezi config/security.php)
TRUSTED_PROXIES=
# Un token lung si aleator; gol = /health dezactivat. Ex: php -r "echo bin2hex(random_bytes(32));"
HEALTH_TOKEN=
RATE_LIMIT_CART=120
RATE_LIMIT_CHECKOUT=20

CSP_MODE=report-only
